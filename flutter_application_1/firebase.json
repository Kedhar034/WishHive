{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/h/**",
        "function": {
          "functionId": "hiveLandingPage",
          "region": "asia-south1"
        }
      }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [{ "key": "Content-Type", "value": "application/json" }]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "flutterapplication-77c19",
          "appId": "1:371898205121:android:a0f50a256255436ced6540",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "flutterapplication-77c19",
          "configurations": {
            "android": "1:371898205121:android:a0f50a256255436ced6540",
            "ios": "1:371898205121:ios:6201088f69f308d6ed6540",
            "macos": "1:371898205121:ios:6201088f69f308d6ed6540",
            "web": "1:371898205121:web:69dd7b0b44d7ba5bed6540",
            "windows": "1:371898205121:web:a2c5934ae74903f1ed6540"
          }
        }
      }
    }
  }
}
